	)
	(text "CAN_GND"
		(exclude_from_sim no)
		(at 49.5 66.68 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "8f67a3c0-2c0d-4d3d-84ce-6b8b902c7878")
	)
	(text "U26 B0505S-1WR3: 5 V to 5 V, 1 W, 1.5 kV isolated, unregulated. It needs\nat least 10 % load (20 mA) to hold its output: R130 || R131 take 10 mA,\nLED7 2 mA and U25 about 8 mA (60-70 mA while driving the bus dominant).\nFB4 / C124 keep its switching noise off the 5 V rail (GPS antenna bias)."
		(exclude_from_sim no)
		(at 48 77.5 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "21966126-71f9-413e-86e6-4a3147429ab9")
	)
	(text "Isolated CAN FD transceiver"
		(exclude_from_sim no)
		(at 21.82 92.94 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "cf1067dc-e96e-447d-aa0b-87d3fb28941b")
	)
	(text "U25 ISO1042B: CAN FD transceiver with 5 kVrms isolation. Logic side on 3V3_MCU,\nbus side on 5V_ISO / CAN_GND. TXD from PA12 (FDCAN1_TX), RXD to PA11 (FDCAN1_RX).\nKeep the isolation gap under U25 and U26 free of copper on all layers."
		(exclude_from_sim no)
		(at 22.86 141 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "9864f6bc-98c4-4a31-b3fc-5555112388f8")
	)
	(text "Bus filter, termination, protection and RJ45"
		(exclude_from_sim no)
		(at 141.2 26.9 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
		(uuid "95f6f2e8-1a9c-4095-b2a3-e3ff98e515c8")
	)
	(text "CAN_GND"
		(exclude_from_sim no)
		(at 240.5 53.74 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "0f12eac8-3f8d-42e0-a0f2-a6d7ce94d5fd")
	)
	(text "CAN_GND"
		(exclude_from_sim no)
		(at 240.5 63.9 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "15db75f8-ad76-4742-885e-1dbbcbecb58d")
	)
	(text "R135 / C129: static bleed and HF return\nfrom CAN_GND to board GND (2 kV cap)."
		(exclude_from_sim no)
		(at 143 101.5 0)
		(effects
			(font
				(size 0.9 0.9)
			)
			(justify left top)
		)
		(uuid "40ca29fa-21e8-4326-850f-0f6b3ec23f82")
	)
	(text "J20 RJ45 uses the CiA 303-1 pinout, the same as the CN1/CN2 ports of the DSY-C servo drives:\npin 1 = CAN_H, pin 2 = CAN_L, pin 3 = CAN_GND (pin 7 is also CAN_GND; pins 4, 5, 6, 8 open).\nA straight Cat5 patch cable links the board to the first drive; daisy-chain from there.\nOne bus only. This board is the CANopen master: servo drives, the future encoder and\nlimit-switch nodes and any other devices share it, through a hub board if needed.\nSW2: both switches ON = 120 Ω split termination (R133 + R134, C128 to CAN_GND).\nSwitch it ON when the board is at one end of the bus; the far end is terminated by the\nlast drive (its DIP switch SW4). D35 clamps the lines to CAN_GND; L4 is a common-mode choke.\nShield to CHASSIS."
		(exclude_from_sim no)
		(at 143 118 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left top)
		)
		(uuid "74098ce4-4805-4bf6-a281-e8ffb3b9336d")
	)
