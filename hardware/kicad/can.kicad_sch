	(text "Isolated CAN (CANopen)"
		(exclude_from_sim no)
		(at 20 16 0)
		(effects
			(font
				(size 5 5)
			)
			(justify left top)
		)
		(uuid "8e11c826-43ba-415d-83a5-79f5e419a2b5")
	)
	(text "Isolated 5 V supply for the bus side"
		(exclude_from_sim no)
		(at 21.82 26.9 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left top)
		)
